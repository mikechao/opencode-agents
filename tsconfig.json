{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid"
  },
  "include": [
    ".opencode/plugins/opencode-agents/**/*.ts",
    ".opencode/plugins/opencode-agents/**/*.tsx",
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
